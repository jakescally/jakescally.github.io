---
import { Image } from "astro:assets";

import { requireImage, shouldUseCompactImageCard } from "@/lib/assets";
import type { BlogEntry } from "@/lib/content";
import { formatShortDate, getPostNumber } from "@/lib/content";

interface Props {
  entry: BlogEntry;
}

const { entry } = Astro.props;
const href = `/writing/${entry.data.slug}/`;
const number = getPostNumber(entry);
const heroImage = entry.data.heroImage ? requireImage(entry.data.heroImage) : undefined;
const compact = heroImage ? shouldUseCompactImageCard(heroImage) : false;
---

<article
  class:list={[
    "post-card",
    !heroImage && "post-card--no-image",
    compact && "post-card--compact"
  ]}
>
  {!heroImage && (
    <a class="post-card__image post-card__image--empty" href={href} tabindex="-1" aria-hidden="true">
      {number && <span>No. {number}</span>}
    </a>
  )}
  {heroImage && (
    <a class="post-card__image" href={href} tabindex="-1" aria-hidden="true">
      <Image
        src={heroImage}
        alt=""
        widths={[480, 720, 960]}
        sizes={compact ? "(min-width: 960px) 12rem, 40vw" : "(min-width: 960px) 26vw, 100vw"}
      />
    </a>
  )}
  <div class="post-card__body">
    <p class="post-card__meta">
      {number && <span class="cat-num">No. {number}</span>}
      <span>{formatShortDate(entry.data.publishedAt)}</span>
    </p>
    <h3 class="post-card__title">
      <a href={href}>{entry.data.title}</a>
    </h3>
    <p class="post-card__summary">{entry.data.description}</p>
    <div class="topic-row">
      {entry.data.topics.slice(0, 3).map((topic) => (
        <span class="topic-pill">{topic}</span>
      ))}
    </div>
  </div>
</article>
