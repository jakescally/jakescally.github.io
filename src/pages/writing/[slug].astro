---
import GalleryEmbed from "@/components/GalleryEmbed.astro";
import InlineImage from "@/components/InlineImage.astro";
import LightboxImage from "@/components/LightboxImage.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  formatDate,
  getBlogPostBySlug,
  getPostNumber,
  getPublishedPosts,
  getRelatedPosts
} from "@/lib/content";

export function getStaticPaths() {
  return getPublishedPosts().map((entry) => ({
    params: { slug: entry.data.slug }
  }));
}

const entry = getBlogPostBySlug(Astro.params.slug);

if (!entry) {
  throw new Error(`Missing blog entry: ${Astro.params.slug}`);
}

const allEntries = getPublishedPosts();
const relatedPosts = getRelatedPosts(entry, allEntries);
const Content = entry.Content;
const hasHeroImage = Boolean(entry.data.heroImage);
const number = getPostNumber(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.heroImage}
  bodyClass="page-article"
>
  <article class="frame article-shell">
    <header class="article-hero">
      <p class="eyebrow">Writing{number && ` · No. ${number}`}</p>
      <h1>{entry.data.title}</h1>
      <p class="article-hero__dek">{entry.data.description}</p>
    </header>

    {hasHeroImage && (
      <LightboxImage
        asset={entry.data.heroImage}
        alt={entry.data.title}
        caption={entry.data.title}
        rootTag="div"
        rootId={`article-hero-${entry.data.slug}`}
        rootClass="article-hero__media"
        linkClass="article-hero__media-link"
        widths={[840, 1200, 1600]}
        sizes="(min-width: 1120px) 60vw, 100vw"
      />
    )}

    <div class="article-body">
      <aside class="article-aside" aria-label="Details">
        <table class="spec-table">
          <tbody>
            {number && <tr><th scope="row">No.</th><td>{number}</td></tr>}
            <tr><th scope="row">Published</th><td>{formatDate(entry.data.publishedAt)}</td></tr>
            {entry.data.updatedAt && (
              <tr><th scope="row">Updated</th><td>{formatDate(entry.data.updatedAt)}</td></tr>
            )}
            {entry.data.topics.length > 0 && (
              <tr><th scope="row">Topics</th><td>{entry.data.topics.join(", ")}</td></tr>
            )}
          </tbody>
        </table>
      </aside>
      <div class="article-content prose">
        <Content components={{ GalleryEmbed, InlineImage }} />
      </div>
    </div>
  </article>

  <div class="frame">
    <RelatedPosts entries={relatedPosts} />
  </div>
</BaseLayout>
