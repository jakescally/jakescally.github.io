---
import LightboxImage from "@/components/LightboxImage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getCaseStudyProjects,
  getProjectBySlug
} from "@/lib/content";

export function getStaticPaths() {
  return getCaseStudyProjects()
    .map((entry) => ({
      params: { slug: entry.data.slug }
    }));
}

const entry = getProjectBySlug(Astro.params.slug);

if (!entry || entry.data.detailMode !== "case-study") {
  throw new Error(`Missing case study project: ${Astro.params.slug}`);
}

const Content = entry.Content;
const hasHeroImage = Boolean(entry.data.heroImage);
const links = [
  { label: "GitHub", href: entry.data.links.github },
  { label: "Demo", href: entry.data.links.demo },
  { label: "Write-up", href: entry.data.links.writeup }
].filter((link): link is { label: string; href: string } => Boolean(link.href));
---

<BaseLayout title={entry.data.title} description={entry.data.summary} image={entry.data.heroImage}>
  <article class="frame article-shell">
    <header class="article-hero">
      <p class="eyebrow">Project</p>
      <h1>{entry.data.title}</h1>
      <p class="article-hero__dek">{entry.data.summary}</p>
    </header>

    {hasHeroImage && (
      <LightboxImage
        asset={entry.data.heroImage}
        alt={entry.data.title}
        caption={entry.data.title}
        rootTag="div"
        rootId={`project-hero-${entry.data.slug}`}
        rootClass="article-hero__media"
        linkClass="article-hero__media-link"
        widths={[840, 1200, 1600]}
        sizes="(min-width: 1120px) 60vw, 100vw"
      />
    )}

    <div class="article-body">
      <aside class="article-aside" aria-label="Details">
        <table class="spec-table">
          <tbody>
            <tr><th scope="row">Year</th><td>{entry.data.year}</td></tr>
            <tr><th scope="row">Status</th><td>{entry.data.status}</td></tr>
            {entry.data.stack.length > 0 && (
              <tr><th scope="row">Stack</th><td>{entry.data.stack.join(", ")}</td></tr>
            )}
            {links.map((link) => (
              <tr><th scope="row">{link.label}</th><td><a href={link.href}>{link.href.replace(/^https?:\/\//, "")}</a></td></tr>
            ))}
          </tbody>
        </table>
      </aside>
      <div class="prose article-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
