---
import GalleryEmbed from "@/components/GalleryEmbed.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getPhotoSetBySlug, getPhotoSets } from "@/lib/content";

export function getStaticPaths() {
  return getPhotoSets().map((entry) => ({
    params: { slug: entry.data.slug }
  }));
}

const entry = getPhotoSetBySlug(Astro.params.slug);

if (!entry) {
  throw new Error(`Missing photo set: ${Astro.params.slug}`);
}

const Content = entry.Content;
---

<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.coverImage}>
  <article class="frame article-shell">
    <header class="article-hero">
      <p class="eyebrow">Photography</p>
      <h1>{entry.data.title}</h1>
      <p class="article-hero__dek">{entry.data.description}</p>
    </header>

    <div class="article-body">
      <aside class="article-aside" aria-label="Details">
        <table class="spec-table">
          <tbody>
            {entry.data.camera && <tr><th scope="row">Camera</th><td>{entry.data.camera}</td></tr>}
            {entry.data.location && <tr><th scope="row">Location</th><td>{entry.data.location}</td></tr>}
            {entry.data.date && <tr><th scope="row">Date</th><td>{formatDate(entry.data.date)}</td></tr>}
            <tr><th scope="row">Photos</th><td>{entry.data.images.length}</td></tr>
          </tbody>
        </table>
      </aside>
      <div class="prose article-content">
        <Content />
      </div>
    </div>

    <GalleryEmbed set={entry.id} />
  </article>
</BaseLayout>
